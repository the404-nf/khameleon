{
  "name": "@khameleon/theme-khameleon",
  "version": "0.1.6",
  "private": false,
  "description": "The Khameleon signature theme — emerald spine, jungle ink, iridescent violet. Adaptive by nature.",
  "author": "Meta Open Source",
  "license": "MIT",
  "homepage": "https://github.com/the404-nf/khameleon#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the404-nf/khameleon.git",
    "directory": "packages/themes/khameleon"
  },
  "bugs": {
    "url": "https://github.com/the404-nf/khameleon/issues"
  },
  "keywords": [
    "khameleon",
    "theme",
    "design-system",
    "lucide",
    "design-tokens"
  ],
  "sideEffects": false,
  "main": "./dist/source.js",
  "types": "./dist/source.d.ts",
  "exports": {
    ".": {
      "types": "./dist/source.d.ts",
      "import": "./dist/source.mjs",
      "require": "./dist/source.js"
    },
    "./built": {
      "types": "./dist/khameleon.d.ts",
      "import": "./dist/khameleon.js",
      "require": "./dist/khameleon.js"
    },
    "./theme.css": {
      "types": "./theme.css.d.ts",
      "default": "./dist/theme.css"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "khameleon theme build src/khameleonTheme.ts -o dist/theme.css && tsup && tsc --project tsconfig.build.json"
  },
  "dependencies": {
    "lucide-react": "^1.38.0"
  },
  "peerDependencies": {
    "@khameleon/core": "0.1.6",
    "react": ">=19"
  },
  "devDependencies": {
    "@khameleon/cli": "0.1.6"
  },
  "module": "./dist/source.mjs"
}
