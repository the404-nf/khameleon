{
  "name": "@khameleon/cli",
  "version": "0.1.6",
  "displayName": "CLI",
  "description": "Scaffold projects, browse templates, generate themes, and get agent-ready docs from the command line.",
  "author": "Meta Open Source",
  "license": "MIT",
  "homepage": "https://github.com/the404-nf/khameleon#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the404-nf/khameleon.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/the404-nf/khameleon/issues"
  },
  "keywords": [
    "khameleon",
    "cli",
    "design-system",
    "init",
    "swizzle",
    "scaffolding",
    "theme",
    "agent-docs"
  ],
  "type": "module",
  "bin": {
    "khameleon": "./bin/khameleon.mjs",
    "cli": "./bin/khameleon.mjs"
  },
  "exports": {
    ".": "./bin/khameleon.mjs",
    "./json": {
      "types": "./src/types/index.d.ts",
      "import": "./src/lib/parse.mjs"
    },
    "./api": {
      "types": "./src/types/api.d.ts",
      "import": "./src/api/index.mjs"
    },
    "./config": {
      "types": "./src/types/config.d.ts",
      "import": "./src/config.mjs"
    },
    "./integration": {
      "types": "./src/types/integration.d.ts",
      "import": "./src/integration.mjs"
    },
    "./doc": {
      "types": "./src/types/doc.d.ts",
      "import": "./src/doc.mjs"
    },
    "./template": {
      "types": "./src/types/template-api.d.ts",
      "import": "./src/template.mjs"
    },
    "./codemod": {
      "types": "./src/types/codemod.d.ts",
      "import": "./src/codemod.mjs"
    },
    "./xle": {
      "types": "./src/lib/xle/browser.d.ts",
      "import": "./src/lib/xle/browser.mjs"
    }
  },
  "files": [
    "bin",
    "src",
    "templates",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "khameleon": "node bin/khameleon.mjs",
    "typecheck:template-docs": "tsc --project tsconfig.template-docs.json",
    "typecheck:json-api": "tsc --project tsconfig.json-api.json && tsc --project tsconfig.api-contract.json"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^12.1.0",
    "jiti": "^2.7.0",
    "jscodeshift": "^17.3.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@khameleon/charts": "*",
    "@khameleon/core": "*",
    "@khameleon/lab": "*",
    "@khameleon/theme-neutral": "*",
    "gpt-tokenizer": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "@khameleon/charts": {
      "optional": true
    },
    "@khameleon/core": {
      "optional": true
    },
    "@khameleon/lab": {
      "optional": true
    },
    "@khameleon/theme-neutral": {
      "optional": true
    }
  },
  "devDependencies": {
    "@khameleon/charts": "*",
    "@khameleon/core": "*",
    "@khameleon/lab": "*",
    "@khameleon/theme-neutral": "*",
    "gpt-tokenizer": "^3.4.0"
  }
}
