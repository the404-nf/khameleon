{
  "name": "khameleon",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "pnpm -F @khameleon/build build && pnpm -F @khameleon/core build && pnpm -F @khameleon/lab build && pnpm -F @khameleon/charts build && pnpm -F @khameleon/vega build && pnpm -F @khameleon/theme-neutral build && pnpm -F @khameleon/theme-matcha build && pnpm -F @khameleon/theme-stone build && pnpm -F @khameleon/theme-gothic build && pnpm -F @khameleon/theme-chocolate build && pnpm -F @khameleon/theme-y2k build && pnpm -F @khameleon/theme-butter build && pnpm -F @khameleon/theme-khameleon build && pnpm -F @khameleon/tailwind build && pnpm bundle:cli-themes",
    "bundle:cli-themes": "node scripts/generate-cli-themes.mjs",
    "dev": "pnpm -F @khameleon/storybook dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "check:package-boundaries": "node scripts/check-package-boundaries.js",
    "check:repo": "pnpm check:sync && pnpm check:package-boundaries && pnpm check:changesets && pnpm check:demo-media && pnpm check:executable-bits",
    "check:changesets": "node scripts/check-changesets.mjs",
    "check:executable-bits": "node scripts/check-executable-bits.mjs",
    "check:demo-media": "node scripts/check-demo-media.mjs",
    "check:sync": "node scripts/check-sync.js",
    "lint": "pnpm check:repo && eslint . --cache",
    "lint:strict": "pnpm check:repo && KHAMELEON_STRICT_LINT=1 eslint . --cache",
    "storybook": "pnpm -F @khameleon/storybook dev",
    "storybook:build": "pnpm -F @khameleon/storybook build",
    "docsite": "pnpm -F @khameleon/docsite dev",
    "sync:exports": "node scripts/sync-exports.js",
    "sync:exports:check": "node scripts/sync-exports.js --check",
    "khameleon": "pnpm -F @khameleon/cli khameleon",
    "package:source": "node scripts/package-source.js",
    "changeset": "changeset",
    "changeset:new": "node scripts/changeset-new.mjs",
    "version-packages": "changeset version && node scripts/format-changelogs.mjs",
    "format-changelogs": "node scripts/format-changelogs.mjs",
    "setup-trusted-publishing": "node scripts/npm/setup-trusted-publishing.mjs",
    "verify-exports": "node scripts/verify-exports.mjs",
    "release": "pnpm build && changeset publish",
    "prepare": "husky install",
    "dev:sandbox": "pnpm -F @khameleon/core build && pnpm -F @khameleon/sandbox dev",
    "dev:sandbox:source": "KHAMELEON_SOURCE=1 pnpm -F @khameleon/sandbox dev"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^2.31.0",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dom-accessibility-api": "^0.7.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "husky": "^9.1.7",
    "jscodeshift": "^17.3.0",
    "jsdom": "^27.4.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "catalog:",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.10.0",
  "lint-staged": {
    "*.{ts,tsx}": "eslint --cache --fix",
    "*.{ts,tsx,md}": "prettier --write"
  }
}
